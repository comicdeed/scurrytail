[Unit]
Description=ScurryTail - Nimble System Tray Kernel Error Monitor
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/scurrytail
Restart=on-failure
RestartSec=5
MemoryMax=64M
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=graphical-session.target
